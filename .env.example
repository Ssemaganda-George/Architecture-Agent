# ==========================================
# LLM Provider Configuration
# ==========================================
# LLM_PROVIDER=auto
# Options:
#   auto        - auto-detect based on which API key is set
#   openai      - force OpenAI
#   gemini      - force Google Gemini
#   groq        - force Grok
#   openrouter  - force OpenRouter
#
# If LLM_PROVIDER is not set, the client selects the provider automatically
# based on the API key you provide below.

# ==========================================
# OpenAI Configuration
# ==========================================
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_GENERATION_URL=https://api.openai.com/v1/chat/completions
# OPENAI_EMBEDDING_URL=https://api.openai.com/v1/embeddings

# ==========================================
# Grok (Groq) Configuration
# ==========================================
# GROQ_API_KEY=gsk_your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_EMBEDDING_MODEL=text-embedding-3-small
# GROQ_GENERATION_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_EMBEDDING_URL=https://api.groq.com/openai/v1/embeddings

# ==========================================
# OpenRouter Configuration
# ==========================================
# OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TEXT_MODEL=google/gemma-3-27b-it
# OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_GENERATION_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_EMBEDDING_URL=https://openrouter.ai/api/v1/embeddings

# ==========================================
# Gemini Configuration
# ==========================================
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GENERATION_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent

# ==========================================
# Shared Model Overrides (optional)
# ==========================================
# These apply to whichever provider is active and override provider-specific defaults.
# LLM_TEXT_MODEL=
# LLM_EMBEDDING_MODEL=

# ==========================================
# Optional Search API
# ==========================================
# SEARCH_API_KEY=
# SEARCH_API_URL=
